	(juktoborno_state
		(slicer
			(delete @-)
			(cond
				((= SLICER 1)  (move @-)  (delete @-)  (move @>) (set FrstCnstID ScndCnstID) (shift byanjon_state) )
				;; লক্ষ্যণীয়, এখানে স্লাইসিংয়ের পরই ScndCnstID এর মান FrstCnstID -তে সেট করা হচ্ছে। যাতে এর পরে অন্য কোনো ব্যঞ্জন লিখলে সেটা যুক্তবর্ণ গঠন করতে পারে।
				;; SLICER = 1 সাধারণ যুক্তবর্ণের জন্য। যেগুলোকে কেবল হসন্ত মুছে দিয়েই ভেঙে দেওয়া যায়।
				((= SLICER 2)  (move @-)  (delete @-2)  (move @>) (set FrstCnstID ScndCnstID) (shift byanjon_state) )
				;; SLICER = 2 ব্যবহার করা হয় যখন যুক্তবর্ণের মাঝে হসন্তের সাথে সাথে ZWNJ থাকে।
				((= SLICER 3)
					(cond
						((= ALTERNATE 1)  (delete @-3) (insert "কখ") (set FrstCnstID 2) (shift byanjon_state) )
						((= ALTERNATE 2)  (delete @-3) (insert "গগ") (set FrstCnstID 3) (shift byanjon_state) )
						((= ALTERNATE 3)  (delete @-3) (insert "ণন") (set FrstCnstID 20) (shift byanjon_state) )
						((= ALTERNATE 4)  (delete @-3) (insert "তট") (set FrstCnstID 11) (shift byanjon_state) )
						((= ALTERNATE 5)  (delete @-3) (insert "দড") (set FrstCnstID 13) (shift byanjon_state) )
						((= ALTERNATE 6)  (delete @-3) (insert "নচ") (set FrstCnstID 6) (shift byanjon_state) )
						((= ALTERNATE 7)  (delete @-3) (insert "নছ") (set FrstCnstID 7) (shift byanjon_state) )
						((= ALTERNATE 8)  (delete @-3) (insert "নজ") (set FrstCnstID 8) (shift byanjon_state) )
						((= ALTERNATE 9)  (delete @-3) (insert "নঝ") (set FrstCnstID 9) (shift byanjon_state) )
						((= ALTERNATE 10)  (delete @-3) (insert "নণ") (set FrstCnstID 15) (shift byanjon_state) )
						((= ALTERNATE 11)  (delete @-3) (insert "ষন") (set FrstCnstID 20) (shift byanjon_state) )
						((= ALTERNATE 12) (delete @-4) (insert "ন্সট") (set FrstCnstID 11) (shift byanjon_state))
						((= ALTERNATE 13) (delete @-4) (insert "ম্পল") (set FrstCnstID 28) (shift byanjon_state))
						((= ALTERNATE 14) (delete @-4) (insert "জ্ঞগ") (set FrstCnstID 3) (shift byanjon_state))
					)
				)
				;; SLICER = 3 তখন দেওয়া হয় যখন কেবল হসন্ত কিংবা ZWNJ মুছে ভাঙা যৌক্তিক না। যেমন: kkh/ = কখ হবে, কষ নয়।
				((= SLICER 4)  (move @-) (move @-) (move @-)  (delete @-)  (move @>) )
				;; SLICER = 4 কেবল তখন ব্যবহার হয় যখন শেষ ব‍র্ণটি kf দিয়ে লেখা ক্ষ হয়। যেমন: ngkf/ = ঙক্ষ
			)
			(set SLICER 0)
		)
		(diacritic  (shift shor_state))
		(slicer2 (shift init))
		(slicer3 (shift init))
		(prithayok (delete @-)  (shift init))
		(ongko  (shift init))
		(biram  (shift shor_state))
		(kar (shift shor_state))
		(phola
			(cond
				((&  (= FrstCnstID 27) (= CnstID 27)) (move @-) (move @-) (delete @-) (move @>) (shift rr_state) (set CnstID 187) )
				;; র ফলার পরে র লিখলে র ফলা বাতিল করে রর আনতে।
				((= FrstCnstID 191) ;; র্র
					(cond
						((= CnstID 27) (delete @-4) (set ScndCnstID CnstID) (set CnstID 187) (insert "রররর") (shift rr_state)) ;; র
					)
				)
				;; র্র এর পরে র লিখলে রররর আনতে।
				(1 (move @-) (insert ?্) (move @>) (set ScndCnstID CnstID) (set SLICER 1) )
			)
			(set PrvCnstID FrstCnstID) (set FrstCnstID CnstID) ;; ব্যঞ্জনের পরে ব্যঞ্জন লেখা হলে শেষ যত CnstID সেট করা হলো, হোক সেটা যুক্তবর্ণ কিংবা একক ব্যঞ্জন, সেটার CnstID -কে FrstCnstID তে পাঠিয়ে দেওয়া হলো। যাতে এর পরে আবার ব্যঞ্জন লেখা হলে সেটা এটার সাথে যুক্ত করা বা না করার সিদ্ধান্ত নেওয়া যায়।
		)
		(byanjon
			(cond
				((= CnstID 0) (shift init))
				((= FrstCnstID 39) ;; ক্ষ
					(cond
						((= CnstID 15) (delete @-4) (set ScndCnstID CnstID) (set CnstID 172) (set SLICER 1) (insert "ক্ষ্ণ")) ;; ণ
						((= CnstID 20) (delete @-4) (set ScndCnstID CnstID) (set CnstID 172) (set SLICER 3) (set ALTERNATE 11) (insert "ক্ষ্ণ")) ;; ন
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 173) (set SLICER 1) (insert "ক্ষ্ব")) ;; ব
						((= CnstID 25) (delete @-4) (set ScndCnstID CnstID) (set CnstID 174) (set SLICER 1) (insert "ক্ষ্ম")) ;; ম
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 65) ;; জ্ঞ
					(cond
						((& (= CnstID 3) (= ScndCnstID 3)) (delete @-4) (set ScndCnstID CnstID) (set CnstID 175) (set SLICER 3) (set ALTERNATE 14) (insert "গ্‌গ")) ;; গ
						(1 (shift byanjon_state))
					)
					;; ScndCnstID -এর (সম্ভবত) একমাত্র ব্যবহার হয়েছে এখানে। এখানে FrstCnstID হচ্ছে 'জ্ঞ' -এর ID, আর ScndCnstID হচ্ছে 'গ' -এর ID.
					;; গ + গ + গ লেখা হয়েছে। CnstID = 3 বলতে বুঝি: শেষে 'গ' লেখা হয়েছে; FrstCnstID = 65 বলতে বুঝি: শেষের 'গ' -এর আগে 'জ্ঞ' ছিল; আর ScndCnstID = 3 বলতে বুঝি FrstCnstID -এর যুক্তবর্ণটি (এক্ষেত্রে 'জ্ঞ') কোন্ ব্যঞ্জন লেখামাত্র গঠিত হয়েছে। এক্ষেত্রে একেবারে প্রথম গ এর পরে আরেকটা গ লেখায় 'জ্ঞ' গঠিত হয়েছে। এজন্যই ScndCnstID = 3.
					;; লক্ষ্যণীয় যে, ৩টি 'গ' এর মধ্যে একেবারে প্রথমটি যে 'গ' ছিল সেটা চেক করার কোনো ব্যবস্থা রাখা হয়নি। দরকার নেই তাই।
					;; ScndCnstID তখন ব্যবহার করা হয় যখন যুক্তবর্ণ গঠনের উপায়ের উপর নির্ভর করে যুক্তবর্ণের পরের বর্ণের সাথে আরো যুক্তবর্ণ গঠিত হবে কি হবে না, কিংবা হলে কোন যুক্তবর্ণ হবে সেসব নির্ণয় করার দরকার পড়ে।
				)
				((= FrstCnstID 53) ;; ঙ্ক
					(cond
						((= CnstID 2) (delete @-4) (set ScndCnstID CnstID) (set CnstID 58) (set SLICER 3) (set ALTERNATE 1) (insert "ঙ্ক্ষ")) ;; খ
						((= CnstID 30) (delete @-4) (set ScndCnstID CnstID) (set CnstID 58) (set SLICER 1) (insert "ঙ্ক্ষ")) ;; ষ
						((= CnstID 16) (delete @-4) (set ScndCnstID CnstID) (set CnstID 176) (set SLICER 1) (insert "ঙ্‌ক্ত")) ;; ত
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 60) ;; চ্ছ
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 177) (set SLICER 1) (insert "চ্ছ্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 63) ;; জ্জ
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 178) (set SLICER 1) (insert "জ্জ্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 84) ;; ত্ত
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 179) (set SLICER 1) (insert "ত্ত্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 92) ;; দ্দ
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 180) (set SLICER 1) (insert "দ্দ্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 103) ;; ন্ত
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 181) (set SLICER 1) (insert "ন্ত্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 105) ;; ন্দ
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 182) (set SLICER 1) (insert "ন্দ্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 159) ;; স্ত
					(cond
						((= CnstID 23) (delete @-4) (set ScndCnstID CnstID) (set CnstID 183) (set SLICER 1) (insert "স্ত্ব")) ;; ব
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 162) ;; স্প
					(cond
						((= CnstID 28) (delete @-4) (set ScndCnstID CnstID) (set CnstID 184) (set SLICER 1) (insert "স্প্ল"))	;; ল
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 110) ;; ন্স
					(cond
						((= CnstID 11) (delete @-4) (set ScndCnstID CnstID) (set CnstID 185) (set SLICER 3) (set ALTERNATE 12) (insert "নস্ট")) ;; ট
						(1 (shift byanjon_state))
					)
				)
				((= FrstCnstID 126) ;; ম্প
					(cond
						((= CnstID 28) (delete @-4) (set ScndCnstID CnstID) (set CnstID 186) (set SLICER 3) (set ALTERNATE 13) (insert "মপ্ল"))	;; ল
						(1 (shift byanjon_state))
					)
				)
				(1 (shift byanjon_state)) ;; উপরের কোনোটা ম্যাচ না করার অর্থ শেষে যুক্তবর্ণ নেই, মুক্তব্যঞ্জন রয়েছে। তাই কেবল উপরের কোনোটা ম্যাচ না করলেই ব্যঞ্জন স্টেটে যাওয়া হচ্ছে।
			)
			(set PrvCnstID FrstCnstID) (set FrstCnstID CnstID) ;; ম্যাচ করুক আর না করুক নতুন FrstCnstID সেট করতেই হচ্ছে।
		)
		(blinder (shift blind_state))
		(backspace)
	)
	(rr_state
		(t (shift byanjon_state) )
	)
	(blind_state
		(lowercaseIdentity (move @-) (delete @-) (move @>) (shift blind_state2))
		(uppercaseIdentity (move @-) (delete @-) (move @>) (shift blind_state2))
		(digitsIdentity (move @-) (delete @-) (move @>) (shift blind_state2))
		(symbolsIdentity (move @-) (delete @-) (move @>) (shift blind_state2))
		(prithayok (move @-) (delete @-) (move @>) (shift blind_state2))
	)
	(blind_state2
		(lowercaseIdentity)
		(uppercaseIdentity)
		(digitsIdentity)
		(symbolsIdentity)
		(prithayok (delete @-) (shift init))
	)
